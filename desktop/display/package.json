{
  "name": "ykonnect-display",
  "version": "1.1.0",
  "description": "YKONNECT paired school display player",
  "main": "main.cjs",
  "author": "YKONNECT",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.ykonnect.display",
    "productName": "YKONNECT Display",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "pair.html",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "YKONNECT-Display-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "yeshayekrausz-wq",
      "repo": "raiseroster-test",
      "releaseType": "release"
    }
  }
}
