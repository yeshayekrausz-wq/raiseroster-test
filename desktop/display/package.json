{
  "name": "ykonnect-display",
  "version": "1.1.2",
  "description": "YKonnect paired school display player",
  "main": "main.cjs",
  "author": "YKonnect",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "node ../../scripts/build-display-windows.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.ykonnect.display",
    "productName": "YKonnect Display",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "pair.html",
      "package.json",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "YKONNECT-Display-Setup.exe",
      "signExecutable": false,
      "icon": "assets/display.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "installerIcon": "assets/display.ico",
      "uninstallerIcon": "assets/display.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "yeshayekrausz-wq",
      "repo": "raiseroster-test",
      "releaseType": "release"
    }
  }
}
